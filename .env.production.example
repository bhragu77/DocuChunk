# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENV — copy this to `.env` on the server and fill in the real values:
#     cp .env.production.example .env    &&    nano .env
#
# NOTE: docker-compose.yml already wires the infrastructure vars for you via its
# `environment:` blocks (they OVERRIDE this file):
#     DATABASE_URL = sqlite on the sqlite_data volume
#     CHROMA_MODE=http, CHROMA_HOST=chroma      (talks to the chroma service)
#     REDIS_HOST=redis, UPLOAD_DIR=/app/uploads
# So you do NOT set those here. This file is for SECRETS + your DOMAIN + LLM keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_run_the_command_above
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Your public domain (REQUIRED) ─────────────────────────────────────────────
# The backend HTTPS URL Caddy will serve (your DuckDNS name). Used by CORS + OAuth.
#   * ALLOWED_ORIGINS must include: the backend domain AND your Netlify landing URL.
ALLOWED_ORIGINS=https://REPLACE_BACKEND_DOMAIN,https://REPLACE_NETLIFY_SITE.netlify.app

# ── Generation / LLM (pick ONE) ───────────────────────────────────────────────
# Free option: Google Gemini (aistudio.google.com/apikey → Create API key).
GEN_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_your_gemini_key
GEN_MODEL=gemini-3.1-flash-lite
GEN_TEMPERATURE=0.3
GEN_MAX_TOKENS=1024
GEN_TIMEOUT_S=30
# Leave verification on the same model (cheap enough) — or set VERIFY_* to split.
VERIFY_PROVIDER=
VERIFY_MODEL=
VERIFY_API_KEY=
VERIFY_TEMPERATURE=0.1
VERIFY_MAX_TOKENS=64
# (If you'd rather run with NO LLM for now, set GEN_PROVIDER=stub and skip the key.
#  Retrieval + citations still work; answers return an honest "not configured".)

# ── Embeddings (LOCAL model — sentence-transformers runs in-process, no API) ──
# The worker loads this model at startup; the web process loads it lazily on the
# first search. First run downloads it (~90 MB) from HuggingFace into the hf_cache
# volume, then it's cached. EMBED_PROVIDER=local is the default — set explicitly here.
EMBED_PROVIDER=local
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional — only used if you ever switch EMBED_PROVIDER=hf_api (remote embeddings).
HF_API_TOKEN=

# ── Google OAuth (only if you use "Sign in with Google") ──────────────────────
# The redirect URI MUST be your production HTTPS callback AND be registered in the
# Google Cloud Console (see the deploy guide, step 8). Otherwise Google login 400s.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://REPLACE_BACKEND_DOMAIN/auth/oauth/google/callback

# ── Answer cache / quality knobs (safe defaults) ──────────────────────────────
# CACHE_BACKEND is set to redis by docker-compose.prod.yml — no need to set here.
CACHE_TTL=3600
GEN_MAX_INPUT_TOKENS=4000
VALIDATE_USE_LLM=true
CONTEXT_EXPANSION_ENABLED=true
CONTEXT_EXPANSION_WINDOW=1
CONTEXT_MAX_TOKENS=3000
STREAM_ENABLED=true

# ── Scope-Aware Retrieval Routing (the reasoning fix) ─────────────────────────
SCOPE_ROUTING_ENABLED=true
SCOPE_WHOLE_DOC_MAX_CHUNKS=400

# ── Storage ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
