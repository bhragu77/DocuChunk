# ── App ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for dev. Swap to postgres://user:pass@host/db for production.
DATABASE_URL=sqlite:///./app.db

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# CHROMA_MODE picks the client: "persistent" (local dir, default — dev/test) or
# "http" (a running Chroma server). It is the single source of truth for the mode.
CHROMA_MODE=persistent
# persistent-mode path (CHROMA_PATH is accepted as an alias of CHROMA_PERSIST_DIR)
CHROMA_PERSIST_DIR=./chroma_db
# http-mode target (only used when CHROMA_MODE=http)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── HuggingFace (free tier) ──────────────────────────────────────────────────
# Sign up at huggingface.co → Settings → Access Tokens → New token (read)
HF_API_TOKEN=hf_your_token_here
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_GEN_MODEL=google/flan-t5-base

# ── Generation / LLM (Story 1) ───────────────────────────────────────────────
# GEN_PROVIDER selects the LLM backend. Default "stub" = offline placeholder (no
# API calls) so generation is safe-off until you configure a real key.
#   stub          → deterministic offline provider (default, used in tests)
#   gemini        → google-genai SDK   (pip install google-genai; needs GEMINI_API_KEY)
#   openai_compat → any OpenAI-compatible /chat/completions (DeepSeek/Groq/Ollama/…)
GEN_PROVIDER=stub
# Gemini (aistudio.google.com/apikey → Create API key). NEVER commit a real key.
GEMINI_API_KEY=
GEN_MODEL=gemini-3.1-flash-lite
GEN_TEMPERATURE=0.3
GEN_MAX_TOKENS=1024
GEN_TIMEOUT_S=30
# OpenAI-compatible fallback (only used when GEN_PROVIDER=openai_compat)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── Chat model picker: the "offline" tier ────────────────────────────────────
# The chat UI lets the user pick per-message between "gemini" (accurate cloud) and
# "offline" (a small local LLM via Ollama). This is independent of GEN_PROVIDER —
# only the generation model swaps; retrieval/reranking/verification are unchanged.
# When OFFLINE_ENABLED=true, the app probes OFFLINE_BASE_URL at startup and only
# offers "offline" if Ollama answers (start it with `docker compose --profile offline up`).
OFFLINE_ENABLED=false
OFFLINE_BASE_URL=http://ollama:11434/v1
OFFLINE_API_KEY=ollama                 # Ollama ignores it; the client just needs non-empty
OFFLINE_MODEL=qwen2.5:1.5b             # ~1 GB, CPU-friendly; pull once: `ollama pull qwen2.5:1.5b`
# Its OWN timeout — NOT GEN_TIMEOUT_S (which is tuned for a fast cloud call). A 1.5B
# model on ~4 CPU cores runs ~25 tok/s prefill / ~13 tok/s decode, so one agent
# planner call takes ~20s+ and later agent steps (which re-send gathered evidence)
# take longer still. Raise it further on slower hardware or with a bigger model.
OFFLINE_TIMEOUT_S=180

# ── Model tiering (Story 7) ──────────────────────────────────────────────────
# Verification (citation Tier-2 judge + groundedness) is mechanical yes/no work —
# run it on a CHEAPER, lower-temperature, hard-capped model than generation.
# VERIFY_PROVIDER unset ("") reuses the generation provider (single-model, the
# pre-Story-7 default). Set it (stub|gemini|openai_compat) to split the tiers.
VERIFY_PROVIDER=
VERIFY_MODEL=
VERIFY_API_KEY=          # may share GEMINI_API_KEY / OPENAI_COMPAT_API_KEY
VERIFY_TEMPERATURE=0.1
VERIFY_MAX_TOKENS=64

# ── Answer cache (Story 7) ───────────────────────────────────────────────────
# Skip the whole chain for a repeated (user, doc, doc_version, query). The key is
# version-aware, so a re-upload busts it automatically; TTL is the safety net.
#   none   → caching off (default; pre-Story-7 behavior)
#   memory → in-process LRU (dev/tests)
#   redis  → shared, survives restarts (uses REDIS_* below)
CACHE_BACKEND=none
CACHE_TTL=3600
CACHE_MAX_MEMORY_ENTRIES=1000

# ── Token budgeting (Story 7) ────────────────────────────────────────────────
# Cap the total prompt size; over-budget prompts trim the lowest-ranked sources
# first (highest-ranked preserved). Output caps: GEN_MAX_TOKENS / VERIFY_MAX_TOKENS.
GEN_MAX_INPUT_TOKENS=4000

# ── Citation validation (Story 3) ────────────────────────────────────────────
# Tier 2 LLM judge for SUSPECT citations. false → those become "unverified".
VALIDATE_USE_LLM=true

# ── Context expansion (Story 5) ──────────────────────────────────────────────
# Widen each retrieved chunk to its neighbors (±window by chunk_index) so answers
# spanning a chunk boundary see the full passage. Needs char offsets in Chroma
# metadata — re-upload documents ingested before Story 5 to gain expansion.
CONTEXT_EXPANSION_ENABLED=true
CONTEXT_EXPANSION_WINDOW=1
CONTEXT_MAX_TOKENS=3000

# ── Streaming (Story 6) ──────────────────────────────────────────────────────
# Global kill switch for SSE token streaming on POST /generate/answer. true
# (default) streams tokens then sends a verification event; a request can still
# opt out with ?stream=false. false disables streaming platform-wide (every
# request gets the synchronous JSON body) regardless of ?stream.
STREAM_ENABLED=true

# ── Agentic retrieval (ReAct) — POST /generate/agent ─────────────────────────
# An optional multi-hop layer: the model plans several retrievals before the
# grounded-answer step runs. Ships dark; the route always exists. Safety comes
# from AGENT_MAX_STEPS + loop detection + fallback-to-RAG, not the enable flag.
AGENT_ENABLED=false
AGENT_MAX_STEPS=5
AGENT_MODE=react
# Comma list restricting which tools may run (empty = all): retrieve_docs,fetch_document
AGENT_ALLOWED_TOOLS=

# ── Google OAuth (free) ──────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── Environment ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Observability / tracing (Phase 9A/9B) ────────────────────────────────────
# LLMOps tracing SEAM + Langfuse backend. Instrumentation is always present but
# FAIL-OPEN: when disabled (or when Langfuse is down/misconfigured) the tracer is a
# no-op and the app behaves byte-identically. Langfuse is an OPTIONAL dependency —
# imported lazily; absence → NullTracer, never a startup failure.
#   TRACING_ENABLED  false (default) → NullTracer. "true" activates Langfuse IF keys
#                    are present, else logs a warning and stays on NullTracer.
#   TRACE_CAPTURE    none | metadata | full.
#                    metadata (default): ids, counts, token usage, latencies,
#                    scores — NO document/prompt/completion text.
#                    full: adds prompt + completion text. DEV ONLY.
#                    none: record nothing.
#   LANGFUSE_*       project keys + host. Host defaults to Langfuse Cloud; point it
#                    at your self-hosted stack (see the "observability" compose
#                    profile) to keep all trace data on-prem.
#   TRACE_USER_SALT  salt mixed into hashed user ids (ids are never recorded raw).
#   TRACE_USD_TO_INR display-only USD→INR rate for cost (default 83). Prices per
#                    model live in app/observability/pricing.py; override the table
#                    with TRACE_MODEL_PRICES (JSON) if needed.
TRACING_ENABLED=false
TRACE_CAPTURE=metadata
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACE_USER_SALT=
TRACE_USD_TO_INR=83

# ── Postgres + pgvector ───────────────────────────────────────────────────────
# Relational rows AND embeddings live in one database. VECTOR_BACKEND=chroma
# falls back to the previous Chroma setup (start it with --profile chroma).
# In production POSTGRES_PASSWORD is REQUIRED: every container on the network can
# reach this database. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=docuchunk
DATABASE_URL=postgresql+psycopg2://docuchunk:docuchunk@postgres:5432/docuchunk
VECTOR_BACKEND=pgvector
