# ── App ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for dev. Swap to postgres://user:pass@host/db for production.
DATABASE_URL=sqlite:///./app.db

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# CHROMA_MODE picks the client: "persistent" (local dir, default — dev/test) or
# "http" (a running Chroma server). It is the single source of truth for the mode.
CHROMA_MODE=persistent
# persistent-mode path (CHROMA_PATH is accepted as an alias of CHROMA_PERSIST_DIR)
CHROMA_PERSIST_DIR=./chroma_db
# http-mode target (only used when CHROMA_MODE=http)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── HuggingFace (free tier) ──────────────────────────────────────────────────
# Sign up at huggingface.co → Settings → Access Tokens → New token (read)
HF_API_TOKEN=hf_your_token_here
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_GEN_MODEL=google/flan-t5-base

# ── Generation / LLM (Story 1) ───────────────────────────────────────────────
# GEN_PROVIDER selects the LLM backend. Default "stub" = offline placeholder (no
# API calls) so generation is safe-off until you configure a real key.
#   stub          → deterministic offline provider (default, used in tests)
#   gemini        → google-genai SDK   (pip install google-genai; needs GEMINI_API_KEY)
#   openai_compat → any OpenAI-compatible /chat/completions (DeepSeek/Groq/Ollama/…)
GEN_PROVIDER=stub
# Gemini (aistudio.google.com/apikey → Create API key). NEVER commit a real key.
GEMINI_API_KEY=
GEN_MODEL=gemini-3.1-flash-lite
GEN_TEMPERATURE=0.3
GEN_MAX_TOKENS=1024
GEN_TIMEOUT_S=30
# OpenAI-compatible fallback (only used when GEN_PROVIDER=openai_compat)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── Model tiering (Story 7) ──────────────────────────────────────────────────
# Verification (citation Tier-2 judge + groundedness) is mechanical yes/no work —
# run it on a CHEAPER, lower-temperature, hard-capped model than generation.
# VERIFY_PROVIDER unset ("") reuses the generation provider (single-model, the
# pre-Story-7 default). Set it (stub|gemini|openai_compat) to split the tiers.
VERIFY_PROVIDER=
VERIFY_MODEL=
VERIFY_API_KEY=          # may share GEMINI_API_KEY / OPENAI_COMPAT_API_KEY
VERIFY_TEMPERATURE=0.1
VERIFY_MAX_TOKENS=64

# ── Answer cache (Story 7) ───────────────────────────────────────────────────
# Skip the whole chain for a repeated (user, doc, doc_version, query). The key is
# version-aware, so a re-upload busts it automatically; TTL is the safety net.
#   none   → caching off (default; pre-Story-7 behavior)
#   memory → in-process LRU (dev/tests)
#   redis  → shared, survives restarts (uses REDIS_* below)
CACHE_BACKEND=none
CACHE_TTL=3600
CACHE_MAX_MEMORY_ENTRIES=1000

# ── Token budgeting (Story 7) ────────────────────────────────────────────────
# Cap the total prompt size; over-budget prompts trim the lowest-ranked sources
# first (highest-ranked preserved). Output caps: GEN_MAX_TOKENS / VERIFY_MAX_TOKENS.
GEN_MAX_INPUT_TOKENS=4000

# ── Citation validation (Story 3) ────────────────────────────────────────────
# Tier 2 LLM judge for SUSPECT citations. false → those become "unverified".
VALIDATE_USE_LLM=true

# ── Context expansion (Story 5) ──────────────────────────────────────────────
# Widen each retrieved chunk to its neighbors (±window by chunk_index) so answers
# spanning a chunk boundary see the full passage. Needs char offsets in Chroma
# metadata — re-upload documents ingested before Story 5 to gain expansion.
CONTEXT_EXPANSION_ENABLED=true
CONTEXT_EXPANSION_WINDOW=1
CONTEXT_MAX_TOKENS=3000

# ── Streaming (Story 6) ──────────────────────────────────────────────────────
# Global kill switch for SSE token streaming on POST /generate/answer. true
# (default) streams tokens then sends a verification event; a request can still
# opt out with ?stream=false. false disables streaming platform-wide (every
# request gets the synchronous JSON body) regardless of ?stream.
STREAM_ENABLED=true

# ── Google OAuth (free) ──────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── Environment ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
